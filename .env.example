# AuthNexus local-development defaults. Copy to .env only when overriding them.
# Every service binds to 127.0.0.1. These credentials are disposable and must never be reused.

AUTHNEXUS_ENVIRONMENT=Development
AUTHNEXUS_WEB_ORIGIN=http://localhost:3000
AUTHNEXUS_API_ORIGIN=http://localhost:5220

AUTHNEXUS_POSTGRES_PORT=5432
AUTHNEXUS_POSTGRES_DATABASE=authnexus
AUTHNEXUS_POSTGRES_USERNAME=authnexus
AUTHNEXUS_POSTGRES_PASSWORD=authnexus-local-postgres
AUTHNEXUS_POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=authnexus;Username=authnexus;Password=authnexus-local-postgres

AUTHNEXUS_REDIS_PORT=6379
AUTHNEXUS_REDIS_PASSWORD=authnexus-local-redis
AUTHNEXUS_REDIS_CONNECTION=localhost:6379,password=authnexus-local-redis,abortConnect=false

AUTHNEXUS_MAILPIT_SMTP_PORT=1025
AUTHNEXUS_MAILPIT_UI_PORT=8025
AUTHNEXUS_MAILPIT_SMTP_HOST=localhost
