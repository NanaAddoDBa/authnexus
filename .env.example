# AuthNexus V0.1 configuration placeholders.
# Copy this file to .env only for local development. Never commit .env files.

AUTHNEXUS_ENVIRONMENT=Development
AUTHNEXUS_WEB_ORIGIN=http://localhost:3000
AUTHNEXUS_API_ORIGIN=http://localhost:5180

# These services are introduced in V0.1 Phase B. Use local-only values there.
AUTHNEXUS_POSTGRES_CONNECTION=replace-with-local-connection-string
AUTHNEXUS_REDIS_CONNECTION=replace-with-local-connection-string
